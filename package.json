{
  "name": "routey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Routey — explainable, safety-first route simulation on real-world maps.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:live": "bun run scripts/live-smoke.ts",
    "test:e2e": "uv run --with playwright python tests/e2e.py"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
