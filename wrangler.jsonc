{
  "name": "hackathonprojectaft",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
