# Routey server configuration

# HTTP port for the Bun API/static server.
PORT=8787

# SQLite database. Relative paths resolve from the repository root.
ROUTEY_DB=data/routey.db

# Public routing provider (OSM + Valhalla). Override only if you self-host.
VALHALLA_URL=https://valhalla1.openstreetmap.de/route

# Nominatim requires a descriptive User-Agent and low request volume.
NOMINATIM_USER_AGENT=Routey/1.0 (local simulation demo)
NOMINATIM_EMAIL=

# Optional: enable richer LLM-written explanations. The score is still decided
# by Routey's local explainable engine; the LLM only rewrites the narrative.
# Any OpenAI-compatible chat-completions endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
